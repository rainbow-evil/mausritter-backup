le racing rink"},{"uid":"o6P7-q8R9-s0T1-u2V3","range":0,"content":"Storehouse, stocked with preserves"},{"uid":"w4X5-y6Z7-a8B9-c0D1","range":0,"content":"Hidden riverboat dock"},{"uid":"e2F3-g4H5-i6J7-k8L9","range":0,"content":"Crumbling marble palace, built by ancient mice"},{"uid":"m0N1-o2P3-q4R5-s6T7","range":0,"content":"Scavenged human machine, working"},{"uid":"u8V9-w0X1-y2Z3-a4B5","range":0,"content":"Wooden bridge connects the settlement"},{"uid":"c6D7-e8F9-g0H1-i2J3","range":0,"content":"Unnervingly tall, twisting tower"},{"uid":"k4L5-m6N7-o8P9-q0R1","range":0,"content":"Beautiful flower garden"},{"uid":"s2T3-u4V5-w6X7-y8Z9","range":0,"content":"Pigeon rider’s roost"},{"uid":"a0B1-c2D3-e4F5-g6H7","range":0,"content":"Overgrown statue of an ancient hero"},{"uid":"i8J9-k0L1-m2N3-o4P5","range":0,"content":"Spiral stairwell, leading deep underground"}]},{"uid":"6PT5-64WC-YQFR-ag8a","title":"Adventure site - Treasure","diceFormula":"1d20","rows":[{"uid":"rFrH-MQwm-cZ18-Bc5X","range":0,"content":"Magic sword"},{"uid":"FPGH-Y4JB-Iafv-64se","range":0,"content":"Random spell"},{"uid":"6kEq-OL3G-yuY2-rpoq","range":0,"content":"Roll for Trinket"},{"uid":"ObX7-0mpO-boBV-NfrP","range":0,"content":"Roll for Valuable treasure"},{"uid":"0Axj-FK26-XNpm-7BXk","range":0,"content":"Roll for Unusual treasure"},{"uid":"CxJ3-p6JI-30Cr-SpWR","range":0,"content":"Roll for Large treasure"},{"uid":"kefQ-A7X2-rbpv-97tU","range":0,"content":"Roll for Large treasure"},{"uid":"AyVi-zYzw-h9jU-Popw","range":0,"content":"Roll for Large treasure"},{"uid":"wo84-E7K9-YkYh-qybl","range":0,"content":"Roll for Useful treasure"},{"uid":"a2O2-lj0f-5wbW-wpkS","range":0,"content":"Roll for Useful treasure"},{"uid":"RbJ9-Oy1H-lONT-GsQw","range":0,"content":"Box containing d6 x 100 pips"},{"uid":"UBzy-AjjX-V9Zf-OKo0","range":0,"content":"Bag containing d6 x 50 pips"},{"uid":"d3Eg-VRSd-ypG6-c5UQ","range":0,"content":"Bag containing d6 x 50 pips"},{"uid":"5sgj-4yL4-j5O1-bqXw","range":0,"content":"Bag con