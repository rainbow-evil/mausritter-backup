ent"},{"uid":"tzbQ-XZcE-hlC4-V4de","range":0,"content":"Recently taken from another creature"},{"uid":"oT9K-G6bb-qCRx-p6r3","range":0,"content":"Built by mice to hold the creature"},{"uid":"eVb6-p8hB-8tqL-oYF3","range":0,"content":"Protecting young"},{"uid":"LRSm-8ff1-cUk0-CZsx","range":0,"content":"Permanent home, newly settled"},{"uid":"jNSC-fey6-G9LC-8LJN","range":0,"content":"Permanent home, comfortably appointed"}]},{"uid":"SZmg-GkdJ-I0WP-EQAz","title":"Magic swords - Sword / Power","diceFormula":"1d10","rows":[{"uid":"dKGO-npEj-f5Bb-sWoa","range":0,"content":"Wrought iron / While wielded: You roll critical damage Saves with Advantage"},{"uid":"vHIp-vQSC-51Qr-Ne5c","range":0,"content":"Intricate Fae design / While wielded: You may disguise yourself as any mouse-sized creature"},{"uid":"GvQ7-C5Zh-iSfL-sFxx","range":0,"content":"Rusty nail / Critical damage: Give a Frightened Condition"},{"uid":"oQjD-4eS5-i7Gb-AHGI","range":0,"content":"Snake fang / Critical damage: Deal d6 additional damage to DEX"},{"uid":"j4u3-xNgv-6EYS-s4Ms","range":0,"content":"Toy soldier’s sabre / While wielded: If you lead a warband, they have +1 Armour"},{"uid":"PaeB-cDOb-xe41-GgzU","range":0,"content":"Water-worn glass / While wielded: You can hold breath underwater for 1 Turn"},{"uid":"jJID-0GXo-k2pC-8KIC","range":0,"content":"Wolf tooth / Critical damage: Your next attack is Enhanced"},{"uid":"Jydd-F4BN-mvSb-S5fo","range":0,"content":"Silver sewing needle / Critical damage: Clear all usage dots from a non-spell item in your inventory"},{"uid":"2M5n-akFx-kfmq-qzDi","range":0,"content":"Thorny rose stem / Critical damage: Remove a Condition"},{"uid":"v8MZ-z4yd-NEhz-O2dW","range":0,"content":"Congealed shadow / While wielded: You are invisible when standing perfectly still"}]},{"uid":"TnkM-PCr9-54w8-UF6A","title":"Adventure site - Secret","diceFormula":"1d6","rows":[{"uid":"kRQ3-hgsU-TLxL-FxMZ","range":0,"content":"Monolith humming with arcane energy"},{"uid":"sxbj-oJrF-LOiI-GuPm","range