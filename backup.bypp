, carved out by mice"},{"uid":"rkjn-thAa-vlaw-xim6","range":0,"content":"Wizard’s tower"},{"uid":"NogP-cDVX-0FxE-pV7s","range":0,"content":"Settlement’s grain mill"},{"uid":"TkNQ-7pGn-b0zm-24WH","range":0,"content":"Rat King’s nest"},{"uid":"OJYt-tap0-VxHI-5yS4","range":0,"content":"Skeleton of a great beast"},{"uid":"KLtk-kRdL-sbxE-n6Zb","range":0,"content":"Witch’s academy"},{"uid":"Ybwi-4FKp-Jehp-gXMU","range":0,"content":"Gatehouse to faerie realm"},{"uid":"A0FO-jH7t-NkOm-vjpK","range":0,"content":"Deep mine"},{"uid":"mMBJ-DXmN-lNry-mbW0","range":0,"content":"Bandit’s hideout"},{"uid":"Vith-ihYw-MyPr-pCY5","range":0,"content":"Natural cave"},{"uid":"6XSA-SwWB-ZGlM-evlx","range":0,"content":"Mouse settlement"}]},{"uid":"B6MR-I8i5-L1eT-iVW4","title":"Taverns and inns","diceFormula":"1d12","rows":[{"uid":"w6X7-y8Z9-a0B1-c2D3-alt","range":0,"content":"White / Beetle / Spiced baked carrot"},{"uid":"e4F5-g6H7-i8J9-k0L1-alt","range":0,"content":"Green / Fox / Boiled worm broth"},{"uid":"m2N3-o4P5-q6R7-s8T9-alt","range":0,"content":"Black / Wedge / Blackberry pie"},{"uid":"u0V1-w2X3-y4Z5-a6B7-alt","range":0,"content":"Red / Kernel / Pungent aged cheese"},{"uid":"c8D9-e0F1-g2H3-i4J5-alt","range":0,"content":"Silver / Rat / Barley porridge"},{"uid":"k6L7-m8N9-o0P1-q2R3-alt","range":0,"content":"Crooked / Cheese / Thick river-fish steak"},{"uid":"s4T5-u6V7-w8X9-y0Z1-alt","range":0,"content":"Friendly / Eagle / Baked apple"},{"uid":"a2B3-c4D5-e6F7-g8H9-alt","range":0,"content":"Hidden / Worm / Fried, crumbed insect legs"},{"uid":"i0J1-k2L3-m4N5-o6P7-alt","range":0,"content":"Wiley / Bee / Fresh buttered bread"},{"uid":"q8R9-s0T1-u2V3-w4X5-alt","range":0,"content":"Glass / Lantern / Scavenged candy"},{"uid":"y6Z7-a8B9-c0D1-e2F3-alt","range":0,"content":"Thorny / Rose / Honey-roasted seeds"},{"uid":"g4H5-i6J7-k8L9-m0N1-alt","range":0,"content":"Broken / Knight / Mushroom stew"}]},{"uid":"BGkg-ZOFl-zhca-ebJ2","title":"Adventure site - Obstacles","diceFormula":"1d8","rows":[{"u